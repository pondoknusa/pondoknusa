{
  "name": "hello-world",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "PONDOKNUSA_HOST=0.0.0.0 tsx src/main.ts",
    "build": "tsx ../../packages/cli/dist/bin/pondoknusa.js route:cache && tsx ../../packages/cli/dist/bin/pondoknusa.js view:cache && pondoknusa build --full",
    "start": "PONDOKNUSA_HOST=0.0.0.0 node bootstrap/app.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@pondoknusa/cli": "4.0.0",
    "@pondoknusa/auth": "4.0.0",
    "@pondoknusa/cache": "4.0.0",
    "@pondoknusa/config": "4.0.0",
    "@pondoknusa/core": "4.0.0",
    "@pondoknusa/crypto": "4.0.0",
    "@pondoknusa/database": "4.0.0",
    "@pondoknusa/database-pg": "4.0.0",
    "@pondoknusa/storage": "4.0.0",
    "@pondoknusa/events": "4.0.0",
    "@pondoknusa/http": "4.0.0",
    "@pondoknusa/log": "4.0.0",
    "@pondoknusa/mail": "4.0.0",
    "@pondoknusa/notifications": "4.0.0",
    "@pondoknusa/queue": "4.0.0",
    "@pondoknusa/ssr": "4.0.0",
    "@pondoknusa/validation": "4.0.0",
    "@pondoknusa/views": "4.0.0"
  },
  "devDependencies": {
    "@pondoknusa/testing": "4.0.0",
    "tsx": "^4.20.3",
    "vitest": "^3.2.4"
  }
