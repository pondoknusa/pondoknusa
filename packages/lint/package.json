{
  "name": "@pondoknusa/lint",
  "version": "4.0.1",
  "description": "Static and request-level linter for Pondoknusa applications (routes, auth, CSRF)",
  "type": "module",
  "bin": {
    "pondoknusa-lint": "./dist/bin/pondoknusa-lint.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@pondoknusa/auth": "4.0.1",
    "@pondoknusa/config": "4.0.1",
    "@pondoknusa/core": "4.0.1",
    "@pondoknusa/http": "4.0.1"
  },
  "peerDependencies": {
    "@pondoknusa/database": "^4.0.1"
  },
  "peerDependenciesMeta": {
    "@pondoknusa/database": {
      "optional": true
    }
  },
  "devDependencies": {
    "@pondoknusa/database": "4.0.1"
  },
  "engines": {
    "node": ">=26"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pondoknusa/pondoknusa.git",
    "directory": "packages/lint"
  },
  "publishConfig": {
    "access": "public"
  }
}
